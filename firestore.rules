rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'fabianricky28@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'callSign', 'phoneNumber', 'address', 'role']) &&
        data.keys().hasOnly(['displayName', 'callSign', 'phoneNumber', 'address', 'rtRw', 'emergencyContactName', 'emergencyContactPhone', 'notes', 'role', 'email', 'createdAt', 'updatedAt']) &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.callSign is string && data.callSign.size() > 0 && data.callSign.size() <= 60 &&
        data.phoneNumber is string && data.phoneNumber.size() > 0 && data.phoneNumber.size() <= 20 &&
        data.address is string && data.address.size() > 0 && data.address.size() <= 200 &&
        data.role in ['warga', 'relawan', 'perangkat_desa', 'admin'] &&
        (!('rtRw' in data) || (data.rtRw is string && data.rtRw.size() <= 30)) &&
        (!('emergencyContactName' in data) || (data.emergencyContactName is string && data.emergencyContactName.size() <= 100)) &&
        (!('emergencyContactPhone' in data) || (data.emergencyContactPhone is string && data.emergencyContactPhone.size() <= 20)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120));
    }

    function isValidSosAlert(data) {
      return data.keys().hasAll(['userId', 'userName', 'userCallSign', 'userPhone', 'emergencyType', 'status']) &&
        data.keys().hasOnly(['userId', 'userName', 'userCallSign', 'userPhone', 'emergencyType', 'description', 'address', 'rtRw', 'latitude', 'longitude', 'accuracy', 'status', 'handledByUserId', 'handledByName', 'handledAt', 'resolvedNotes', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
        data.userCallSign is string && data.userCallSign.size() > 0 && data.userCallSign.size() <= 60 &&
        data.userPhone is string && data.userPhone.size() > 0 && data.userPhone.size() <= 20 &&
        data.emergencyType in ['medis', 'kebakaran', 'bencana', 'keamanan', 'lainnya'] &&
        data.status in ['menunggu', 'proses', 'selesai', 'dibatalkan'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
        (!('rtRw' in data) || (data.rtRw is string && data.rtRw.size() <= 30)) &&
        (!('latitude' in data) || (data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0)) &&
        (!('longitude' in data) || (data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0)) &&
        (!('accuracy' in data) || (data.accuracy is number)) &&
        (!('handledByUserId' in data) || (data.handledByUserId is string && data.handledByUserId.size() <= 128)) &&
        (!('handledByName' in data) || (data.handledByName is string && data.handledByName.size() <= 100)) &&
        (!('resolvedNotes' in data) || (data.resolvedNotes is string && data.resolvedNotes.size() <= 500));
    }

    function isValidVillageContact(data) {
      return data.keys().hasAll(['title', 'phone']) &&
        data.keys().hasOnly(['title', 'phone', 'category', 'order', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && (incoming().role == 'warga' || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming()) && (incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin();
    }

    // Relawan & Perangkat Desa Directory
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Emergency SOS Alerts
    match /sos_alerts/{alertId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        isValidSosAlert(incoming()) &&
        incoming().status == 'menunggu';
      allow update: if isSignedIn() &&
        isValidSosAlert(incoming()) &&
        incoming().userId == existing().userId &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'handledByUserId', 'handledByName', 'handledAt', 'resolvedNotes', 'updatedAt'])) ||
          (isOwner(existing().userId) && existing().status == 'menunggu' && incoming().status == 'dibatalkan' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isAdmin();
    }

    // Village Contacts
    match /village_contacts/{contactId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidVillageContact(incoming());
    }
  }
}
